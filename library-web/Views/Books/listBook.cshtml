@model library_web.Models.DTO.BookDTO

@{
    ViewData["Title"] = "Chi tiết sách";
}

<h2>Thông tin sách</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model == null)
{
    <div class="alert alert-warning">Không tìm thấy sách</div>
}
else
{
    <div class="card mb-4">
        <div class="row g-0">
            <div class="col-md-3 text-center p-3">
                @if (!string.IsNullOrEmpty(Model.CoverUrl))
                {
                    <img src="@Model.CoverUrl" class="img-fluid rounded" style="max-height:300px;" alt="Cover" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height:250px;">
                        <span class="text-muted">Không có ảnh</span>
                    </div>
                }
            </div>
            <div class="col-md-9">
                <div class="card-body">
                    <h3 class="card-title">@Model.Title</h3>

                    <p><strong>Mô tả:</strong> @(Model.Description ?? "Không có")</p>

                    <p>
                        <strong>Đã đọc:</strong>
                        @if (Model.IsRead)
                        {
                            <span class="badge bg-success">Đã đọc</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Chưa đọc</span>
                        }
                    </p>

                    <p><strong>Ngày đọc:</strong> @(Model.DateRead?.ToString("dd/MM/yyyy") ?? "—")</p>

                    <p>
                        <strong>Đánh giá:</strong>
                        @if (Model.Rate.HasValue)
                        {
                            for (int i = 0; i < Model.Rate; i++)
                            {
                                <span style="color:gold; font-size:1.2em;">★</span>
                            }
                            <span>(@Model.Rate/5)</span>
                        }
                        else
                        {
                            <span class="text-muted">Chưa có đánh giá</span>
                        }
                    </p>

                    <p><strong>Thể loại:</strong> @(Model.Genre ?? "—")</p>
                    <p><strong>Ngày thêm:</strong> @Model.DateAdded.ToString("dd/MM/yyyy")</p>
                    <p><strong>Nhà xuất bản:</strong> @Model.PublisherName</p>

                    <p>
                        <strong>Tác giả:</strong>
                        @if (Model.AuthorNames != null && Model.AuthorNames.Any())
                        {
                            @string.Join(", ", Model.AuthorNames)
                        }
                        else
                        {
                            <span class="text-muted">Không có</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="editBook" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
}