@model library_web.Models.DTO.editBookDTO

@{
    ViewData["Title"] = "Sửa sách";
    var book = ViewBag.Book as library_web.Models.DTO.BookDTO;
    var listAuthor = ViewBag.ListAuthor as List<library_web.Models.DTO.authorDTO>;
    var listPublisher = ViewBag.ListPublisher as List<library_web.Models.DTO.publisherDTO>;
}

<h2>Sửa sách</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (book == null)
{
    <div class="alert alert-warning">Không tìm thấy sách</div>
}
else
{
    <form asp-action="editBook" asp-route-id="@book.Id" method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Tiêu đề *</label>
                    <input name="Title" value="@book.Title" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <textarea name="Description" class="form-control" rows="3">@book.Description</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Đã đọc?</label><br />
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="IsRead" value="true"
                        @(book.IsRead ? "checked" : "") id="editIsReadYes" />
                        <label class="form-check-label" for="editIsReadYes">Có</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="IsRead" value="false"
                        @(!book.IsRead ? "checked" : "") id="editIsReadNo" />
                        <label class="form-check-label" for="editIsReadNo">Chưa</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ngày đọc</label>
                    <input name="DateRead" type="date" class="form-control"
                           value="@(book.DateRead?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Đánh giá (0-5)</label>
                    <input name="Rate" type="number" min="0" max="5" class="form-control"
                           value="@book.Rate" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Thể loại</label>
                    <input name="Genre" value="@book.Genre" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Cover URL</label>
                    <input name="CoverUrl" value="@book.CoverUrl" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Ngày thêm</label>
                    <input name="DateAdded" type="date" class="form-control"
                           value="@book.DateAdded.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nhà xuất bản *</label>
                    <select name="PublisherID" class="form-select" required>
                        <option value="">-- Chọn NXB --</option>
                        @if (listPublisher != null)
                        {
                            @foreach (var item in listPublisher)
                            {
                                <option value="@item.Id"
                                        selected="@(item.Name == book.PublisherName ? "selected" : null)">
                                    @item.Name
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tác giả * (giữ Ctrl để chọn nhiều)</label>
                    <select name="AuthorIds" class="form-select" multiple required size="5">
                        @if (listAuthor != null)
                        {
                            @foreach (var item in listAuthor)
                            {
                                <option value="@item.Id"
                                        selected="@(book.AuthorNames != null && book.AuthorNames.Contains(item.FullName) ? "selected" : null)">
                                    @item.FullName
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
}